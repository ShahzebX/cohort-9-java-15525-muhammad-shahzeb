# Base URL of the backend API, read at build time by src/api/client.js.
# Vite only exposes variables prefixed with VITE_.
#
# - Leave unset for local development: the Vite dev server proxies /api to
#   http://localhost:8080 (see vite.config.js), so requests stay same-origin.
# - Set it when the API is served from a different origin than the frontend.
#   The value MUST use https:// for any non-localhost host.
#
# Copy this file to `.env` and adjust as needed.

# VITE_API_BASE=https://your-api-host.example.com/api
